# --- Core ---
ENV=development
DATABASE_URL=postgresql+psycopg://jobtrail:jobtrail@localhost:5433/jobtrail

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma-separated, never "*") ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173





# --- Media storage (profile pictures) ---
# "local" writes to backend/media - fine for dev, WIPED on Render/Railway redeploys.
# Use "s3" with Cloudflare R2 (or any S3-compatible service) for deployments.
MEDIA_STORAGE=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=


# --- Follow-up reminders ---
# Nudge about applications with no status change in this many days.

# --- Optional: shared rate-limit store (needed for >1 worker/instance) ---
REDIS_URL=

# --- Job feed (free) ---
# Adzuna: free developer key from https://developer.adzuna.com (2,500 calls a month).
# Unset: the feed runs on Himalayas alone, which needs no key but lists remote roles only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter market code used by both sources.
JOB_COUNTRY=ca
# Identical searches are served from memory this long, to stay inside Adzuna's quota. 0 disables.
FEED_CACHE_MINUTES=180

# --- Gemini (free tier) - the only AI provider, server-side only ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run `python -m app.tasks doctor` to list models this key can call.
GEMINI_MODEL=gemini-3.8-flash
